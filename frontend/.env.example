# AI Legal Document Assistant — Environment Configuration
# Copy this file to .env.local for local development.
# For Vercel deployment, add these as environment variables in the Vercel dashboard.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Groq Cloud API Key
# Obtain from: https://console.groq.com
# Used by: All /api/* serverless routes for AI inference
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Groq Model Override
# Default: llama-3.3-70b-versatile
# ─────────────────────────────────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: External Python Backend URL
# Leave unset (or empty) to use the built-in Next.js Serverless API routes.
# Only set this if you are running the Python FastAPI backend separately.
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
